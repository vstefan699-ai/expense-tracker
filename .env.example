# Copy this file to .env.local and fill in your own Firebase web app config.
# Where to find the values: Firebase console → Settings (gear icon) → Project settings
# → "Your apps" card → select your web app → choose "Config" in the SDK snippet pane.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
